# Copier vers .env. Ne jamais ajouter de secrets dans ce fichier exemple.
PORT=3000
# Utiliser 0.0.0.0 pour exposer le serveur dans un conteneur.
HOST=127.0.0.1
# Origines exactes séparées par des virgules ; vide = aucun accès cross-origin.
# Pour utiliser l'import de CV depuis le frontend Vite : http://127.0.0.1:5173
CORS_ORIGINS=
# Taille maximale d'un CV PDF importé, en octets (1024 à 10000000).
CV_IMPORT_MAX_BYTES=5000000
# Conservation en mémoire du texte extrait, en secondes (60 à 3600).
CV_IMPORT_RETENTION_SECONDS=900
