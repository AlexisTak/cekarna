# Copier vers .env. Ne jamais ajouter de secrets dans ce fichier exemple.
PORT=3000
# Utiliser 0.0.0.0 pour exposer le serveur dans un conteneur.
HOST=127.0.0.1
# Origines exactes séparées par des virgules ; vide = aucun accès cross-origin.
# Les deux adresses couvrent le serveur Vite local, qu’il soit ouvert avec
# localhost ou 127.0.0.1. En production, n’indiquer que l’origine HTTPS réelle.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Taille maximale d'un CV PDF importé, en octets (1024 à 10000000).
CV_IMPORT_MAX_BYTES=5000000
# Conservation en mémoire du texte extrait, en secondes (60 à 3600).
CV_IMPORT_RETENTION_SECONDS=900
CV_IMPORT_MAX_PAGES=10
# Endpoint HTTP(S) du contrôle de session du service Go ; il reste interne en production.
AUTH_IDENTITY_URL=http://127.0.0.1:8081/v1/auth/me
# Modèle local Ollama utilisé uniquement à la demande depuis une fiche d’offre.
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434
LOCAL_LLM_MODEL=hermes3:3b
