# The Docker Compose file reads this file after it has been copied to .env.
POSTGRES_PASSWORD=replace-with-a-local-database-password
NOTIFICATIONS_DATABASE_URL=postgres://cekarna:change-me@127.0.0.1:55433/cekarna_notifications?sslmode=disable
NOTIFICATIONS_INTERNAL_TOKEN=replace-with-a-random-32-byte-secret
NOTIFICATIONS_SMTP_HOST=smtp.provider.example
NOTIFICATIONS_SMTP_PORT=587
NOTIFICATIONS_SMTP_USERNAME=provider-user
NOTIFICATIONS_SMTP_PASSWORD=provider-password-or-api-key
NOTIFICATIONS_SMTP_FROM=Cekarna <no-reply@example.com>

# Optional settings.
NOTIFICATIONS_ADDR=127.0.0.1:8082
NOTIFICATIONS_MAX_ATTEMPTS=5
NOTIFICATIONS_RETRY_SECONDS=60
RUST_LOG=info
