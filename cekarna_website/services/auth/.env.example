# Run `go run ./cmd/auth init-dev` to generate real local values in .env.
# Docker Compose reads .env; the Go HTTP process reads environment variables.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
AUDIT_HMAC_KEY=

# Direct execution / production (not needed for the local Compose):
# APP_ENV=production
# AUTH_ADDR=127.0.0.1:8081
# AUTH_ISSUER=https://auth.example.com
# AUTH_AUDIENCE=cekarna-api
# WEB_ORIGIN=https://app.example.com
# AUTH_SIGNING_KEY_FILE=/run/secrets/ed25519.key
# AUTH_MAILER=smtp
# SMTP_HOST=smtp.provider.example
# SMTP_PORT=587
# SMTP_USERNAME=provider-user
# SMTP_PASSWORD=provider-password-or-api-key
# SMTP_FROM=Cekarna <no-reply@example.com>
# SMTP_TIMEOUT_SECONDS=10
# Or enqueue through services/notifications (recommended once deployed):
# AUTH_MAILER=notifications
# NOTIFICATIONS_URL=https://notifications.internal.example
# NOTIFICATIONS_INTERNAL_TOKEN=a-long-random-internal-secret
# AUTH_PREVIOUS_PUBLIC_KEYS=base64url-public-key-1 base64url-public-key-2
# DATABASE_URL=postgres://auth_runtime:...@db:5432/cekarna_auth?sslmode=verify-full
# REDIS_URL=rediss://auth:...@redis:6379/0
